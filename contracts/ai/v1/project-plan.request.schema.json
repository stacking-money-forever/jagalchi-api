{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jagalchi.dev/schemas/ai/v1/project-plan.request.schema.json",
  "title": "Jagalchi AI v1 project-plan.request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operationId",
    "title",
    "selectedProposalId",
    "proposals",
    "target"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "operationId": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "maxLength": 300,
      "minLength": 1
    },
    "selectedProposalId": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "projectBlueprintId",
          "projectBlueprintVersion",
          "repositoryMode",
          "citedGapIds",
          "citationIds",
          "boundedOutcome",
          "nonGoals",
          "durationHours",
          "difficulty",
          "evidenceRules",
          "confidence",
          "rejectionReasons"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "title": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1
          },
          "projectBlueprintId": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "projectBlueprintVersion": {
            "type": "integer",
            "minimum": 1
          },
          "repositoryMode": {
            "enum": [
              "EXISTING_OWNED",
              "OPEN_SOURCE_CONTRIBUTION",
              "MANUAL_GREENFIELD"
            ]
          },
          "citedGapIds": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "maxItems": 20
          },
          "citationIds": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "maxItems": 20,
            "minItems": 1
          },
          "boundedOutcome": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1
          },
          "nonGoals": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1000,
              "minLength": 1
            },
            "maxItems": 10,
            "minItems": 1
          },
          "durationHours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 160
          },
          "difficulty": {
            "enum": [
              "EASY",
              "MEDIUM",
              "HARD"
            ]
          },
          "evidenceRules": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500,
              "minLength": 1,
              "pattern": "^(pr:changed-path:|pr:named-check:|test:|measurement:|deployment:).+"
            },
            "maxItems": 20,
            "minItems": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rejectionReasons": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1000,
              "minLength": 1
            },
            "maxItems": 10
          }
        }
      },
      "maxItems": 3,
      "minItems": 3
    },
    "target": {
      "enum": [
        "project_run",
        "proof_mission"
      ]
    }
  }
}
