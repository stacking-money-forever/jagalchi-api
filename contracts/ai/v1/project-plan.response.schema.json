{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jagalchi.dev/schemas/ai/v1/project-plan.response.schema.json",
  "title": "Jagalchi AI v1 project-plan.response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operationId",
    "kind",
    "result",
    "citations",
    "receipt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "operationId": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "const": "project_plan"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact"
      ],
      "properties": {
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "schemaVersion",
            "title",
            "target",
            "projectBlueprintId",
            "projectBlueprintVersion",
            "milestones",
            "tasks",
            "firstAction"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "schemaVersion": {
              "const": 1
            },
            "title": {
              "type": "string",
              "maxLength": 300,
              "minLength": 1
            },
            "target": {
              "enum": [
                "project_run",
                "proof_mission"
              ]
            },
            "projectBlueprintId": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "projectBlueprintVersion": {
              "type": "integer",
              "minimum": 1
            },
            "milestones": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "title"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 300,
                    "minLength": 1
                  }
                }
              },
              "maxItems": 8,
              "minItems": 1
            },
            "tasks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "title",
                  "milestoneId",
                  "prerequisiteIds",
                  "purpose",
                  "acceptanceCriteria",
                  "evidenceRules",
                  "citationIds",
                  "gapIds"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 300,
                    "minLength": 1
                  },
                  "milestoneId": {
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                  },
                  "prerequisiteIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 128,
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                    },
                    "maxItems": 3
                  },
                  "purpose": {
                    "type": "string",
                    "maxLength": 2000,
                    "minLength": 1
                  },
                  "acceptanceCriteria": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 1000,
                      "minLength": 1
                    },
                    "maxItems": 20,
                    "minItems": 1
                  },
                  "evidenceRules": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 500,
                      "minLength": 1,
                      "pattern": "^(pr:changed-path:|pr:named-check:|test:|measurement:|deployment:).+"
                    },
                    "maxItems": 20,
                    "minItems": 1
                  },
                  "citationIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 128,
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                    },
                    "maxItems": 20,
                    "minItems": 1
                  },
                  "gapIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 128,
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                    },
                    "maxItems": 20
                  }
                }
              },
              "maxItems": 40,
              "minItems": 1
            },
            "firstAction": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          }
        }
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url",
          "quote"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "title": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          },
          "quote": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1
          }
        }
      },
      "maxItems": 100
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "providerRequestId",
        "promptVersion",
        "inputHash",
        "generatedAt",
        "durationMs",
        "timeoutBudgetSeconds"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "maxLength": 80,
          "minLength": 1
        },
        "model": {
          "type": "string",
          "maxLength": 160,
          "minLength": 1
        },
        "providerRequestId": {
          "type": "string",
          "maxLength": 200
        },
        "promptVersion": {
          "type": "string",
          "maxLength": 80,
          "minLength": 1
        },
        "inputHash": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "timeoutBudgetSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "usage": {
          "type": "object"
        }
      }
    }
  }
}
