{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jagalchi.dev/schemas/ai/v1/project-proposals.request.schema.json",
  "title": "Jagalchi AI v1 project-proposals.request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operationId",
    "objective",
    "findings",
    "gaps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "operationId": {
      "type": "string",
      "format": "uuid"
    },
    "objective": {
      "type": "string",
      "maxLength": 2000,
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "citationIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "statement": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1
          },
          "citationIds": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "maxItems": 20,
            "minItems": 1
          }
        }
      },
      "maxItems": 50,
      "minItems": 1
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "description": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1
          }
        }
      },
      "maxItems": 30
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000,
        "minLength": 1
      },
      "maxItems": 30
    }
  }
}
