{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jagalchi.dev/schemas/ai/v1/job-posting-extract.request.schema.json",
  "title": "Jagalchi AI v1 job-posting-extract.request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operationId",
    "text"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "operationId": {
      "type": "string",
      "format": "uuid"
    },
    "text": {
      "type": "string",
      "maxLength": 50000,
      "minLength": 1
    },
    "sourceUrl": {
      "type": "string",
      "maxLength": 2048,
      "format": "uri"
    },
    "sourceTitle": {
      "type": "string",
      "maxLength": 300,
      "minLength": 1
    }
  }
}
